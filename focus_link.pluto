enum specialRefs begin
    SPECIAL_INT_SELECT = 511,
    SPECIAL_TEXT_SELECT = 3,
    SPECIAL_LIST = 73,
    SPECIAL_PROF_LIST = 70
end

local function getFocusedCommand(): ?userdata
    return menu.get_current_menu_list():getFocusPhysical()
end

local tab_root = menu.ref_by_path("Self"):getParent()

-- Get the path from a reference
local function getPathFromRef(commandref: userdata): ?string
    if !commandref:isValid() then return "" end
    local path = lang.get_string(commandref.menu_name, "en")
    while !commandref:equals(tab_root) do
        commandref = commandref:getParent()

        local player_name = false
        for players.list() as player_id do
            if commandref.menu_name != players.get_name_with_tags(player_id) then continue end
            player_name = true
            break
        end

        if commandref:equals(tab_root) then break end

        path = tostring((player_name or commandref:getParent():equals(menu.rbp("Online>Player History"))) and "[Player]" or lang.get_string(commandref.menu_name)).. ">" ..path
    end
    return path
end

local commandrefs = {}
function menu.rbp(path: string, tree_version: ?int = 52): ?int
    switch commandrefs[path]?:isValid?() do
        case nil: case false:
            local success, output = pcall(menu.ref_by_path, path, tree_version)
            commandrefs[path] = success and output:isValid() ? output : nil
    end
    return commandrefs[path] or fake_commandref
end

local function get_type(): ?int
    local ref = getFocusedCommand()
    local type = menu.get_type(ref)
    local output

    for custom_types as t do
        if menu.ref_by_path(t).menu_name == ref.menu_name then
            output = CUSTOM
        else
            output = type
        end
    end

    --print(output)
    return output
end

-- Get the command string from a reference
local function getCommandFromRef(def_value: ?bool = false, allow_type: ?bool = true): ?string
    local ref = getFocusedCommand()
    local cmdPath = getPathFromRef(ref)
    local input = menu.get_command_names(ref)
    local firstInput = input[1]
    local output = ""

    if firstInput then
        local state, defaultstate, otherInputs = ref:getState(), ref:getDefaultState(), {}
        output = firstInput

        if allow_type then
            output = firstInput .. switch get_type() do
                case CUSTOM -> " [name]"
                case COMMAND_LIST -> "" -- whar?
                case COMMAND_LIST_SEARCH -> " [clue]"
                case COMMAND_INPUT -> " [input]"
                case COMMAND_TOGGLE_NO_CORRELATION -> " [on/off]"
                case COMMAND_TOGGLE -> " [on/off]"
                case COMMAND_TOGGLE_CUSTOM -> " [on/off]"
                case COMMAND_SLIDER -> $" [{ref.min_value} to {ref.max_value}]"
                case COMMAND_SLIDER_FLOAT -> $" [{ref.min_value / 100} to {ref.max_value / 100}]"
                case COMMAND_LIST_SELECT -> " [Text]"
                case SPECIAL_INT_SELECT -> $" [{ref.min_value} to {ref.max_value}]" -- setrank
                case SPECIAL_TEXT_SELECT -> "" -- Weird Text select thing
                case SPECIAL_LIST -> "" -- Remove Gun list??
                case SPECIAL_PROF_LIST -> ""
                case COMMAND_FLAG_LIST_ACTION -> ""
                case COMMAND_ACTION -> " " .. state
                case COMMAND_LIST_COLOUR -> "" -- color list
                default -> " " .. firstInput .. (def_value and defaultstate or state)
            end
        else
            output = firstInput -- .. " " .. state
        end

        output = lang.get_localised(output)

        for i = 2, #input do
            otherInputs[i - 1] = input[i]
        end

        for players.list() as player do
            local name = players.get_name(player):lower()
            output = output:gsub(name, " [Player] ")
        end

        return output, table.unpack(otherInputs)
    end
end

local function copyToClipboardWithHelpText(focusLink: string, commandLink: string, helpText: string)
    local clipboardText

    if commandLink or helpText != "" then
        clipboardText = focusLink
    end

    if commandLink and commandLink != "" then
        clipboardText ..= "\n\n" .. commandLink
    end

    if helpText and helpText != "" then
        clipboardText ..= "\n\n- Help Text: " .. helpText
    end

    util.copy_to_clipboard(clipboardText, true)
end

-- Menu action to copy links
local support = menu.list(menu.ref_by_command_name("lenamisc"), "Support Tools", {"supporttools"}, "")
menu.attach_after(menu.ref_by_command_name("lenatp"), menu.detach(support))

menu.action(support, "Copy Link", {"copylinks"}, "Use with Hotkeys.", function()
    local focusLink, commandLink
    local ref = getFocusedCommand()
    local helpText = lang.get_string(menu.get_help_text(ref))
    local state = ref:getState()
    local command, otherCommands = getCommandFromRef()
    local encodedPath = plutoURL.encode(getPathFromRef(ref))
    local modifiedPath = getPathFromRef(ref)

    if modifiedPath:startswith("Players") or modifiedPath:startswith("Online>Player History") then
        focusLink = "- Path: " .. modifiedPath:gsub(">", " > ")
    else
        focusLink = "- Focus Link: [" .. modifiedPath:gsub(">", " > ") .. " 🡭](<https://stand.gg/focus#" .. encodedPath .. ">)"
    end

    local helpText = lang.get_string(menu.get_help_text(ref))

    if command then
        local urlCommand = plutoURL.encode(getCommandFromRef(false, false):gsub(state, ""))

        if modifiedPath:startswith("Players") or modifiedPath:startswith("Online>Player History") then
            commandLink = "- Command: U > " .. command .. " > Enter"
        else
            commandLink = "- Command Link: [U > " .. command:gsub("%%20", " ") .. " > Enter 🡭](<https://stand.gg/commandbox#" .. urlCommand .. ">)"
            if otherCommands then
                commandLink ..= "\n - Other variants: " .. otherCommands
            end
        end

        if commandLink then
            commandLink ..= ref:getDefaultState() != "" and "\n- Default State: " .. ref:getDefaultState() or ""
        end
    end

    copyToClipboardWithHelpText(focusLink, commandLink, helpText)
end)

menu.divider(support, "Links & Commands")
for linkOrder as key do
    local value = links[key]
    menu.action(support, value.name, {"sup"..key}, value.des, function()
        util.copy_to_clipboard(value.text, true)
    end)
end